rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if user owns the document they are trying to access
    function isOwner(resource) {
      return resource.data.userId == request.auth.uid;
    }

    // LEADS: Only owner can Read/Write
    match /leads/{leadId} {
      allow read, update, delete: if isSignedIn() && isOwner(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // BRANDS/CLIENTS: Only owner can Read/Write
    match /brands/{brandId} {
      allow read, update, delete: if isSignedIn() && isOwner(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /clients/{clientId} {
      allow read, update, delete: if isSignedIn() && isOwner(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // SCOUTER LOGS: Only owner can Read/Write
    match /headhunter_logs/{logId} {
      allow read, update, delete: if isSignedIn() && isOwner(resource);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // JOBS: Only owner can Read/Write
    match /jobs/{jobId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.tenantId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // GLOBAL DEFAULTS: Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
